import time

def my_decorator(func):
    
    def wrapper():
        print('Start')
        time.sleep(2)
        func()
        time.sleep(2)
        print('End')
        
    return wrapper
    
@my_decorator
def hello():
    print('Running')
    
    
# hello()

def repeat(times):
    
    def decorator(func):
        
        def wrapper():
            for i in range(times):
                func() 
                time.sleep(2)
            
        return wrapper
    
    return decorator

@repeat(3)
def hello():
    print("Hi")
    

hello()